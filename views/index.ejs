<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <!-- <h1>Hello</h1> -->
    <div class="main w-full min-h-screen bg-zinc-900 text-white">
      <div class="form px-10 py-10">
        <form action="/create" method="post">
          <input
            class="block px-5 w-full rounded-md outline-none py-2 bg-zinc-800 mt-2"
            type="text"
            placeholder="Enter Your Task Title here"
            name="title"
          />
          <textarea
            class="block px-5 py-2 w-full rounded-md outline-none bg-zinc-800 resize-none mt-2"
            placeholder="Write your task details here"
            name="details"
          ></textarea>
          <input
            class="bg-blue-500 px-5 py-2 mt-4 rounded-md"
            type="submit"
            value="create task"
          />
        </form>
      </div>
      <div class="tasks flex gap-3 flex-wrap px-10">
        <% if (files.length > 0) { %> <% files.forEach((val) => { %>
        <div class="task min-w-72 py-4 bg-zinc-800 p-10 rounded-md">
          <h1 class="text-2xl tracking-tighter"><%= val %></h1>
          <a class="text-blue-500 inline-block m-3" href="/file/<%= val %>"
            >Read More</a
          >
        </div>
        <% }); %> <% } else { %>
        <h3 class="text-zinc-600">NO Tasks Yet</h3>
        <% } %>
      </div>
    </div>
  </body>
</html>
